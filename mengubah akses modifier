class ProgramStudi:
    # 1. Public: kode
    # 2. Protected: _ketua
    # 3. Private: __anggaran
    def __init__(self, kode, ketua):
        self.kode = kode                
        self._ketua = ketua             
        self.__anggaran = 500000000   
        
    # Getter protected 
    def get_ketua(self): 
        return self._ketua 
    
    # Setter protected 
    def set_ketua(self, nama_baru): 
        if not nama_baru: 
            raise ValueError("Nama ketua tidak boleh kosong.") 
        self._ketua = nama_baru 

    # Getter private (wajib karena __anggaran private) 
    def get_anggaran(self): 
        return self.__anggaran 
    
    # Setter private 
    def set_anggaran(self, nilai): 
        if nilai < 0: 
            raise ValueError("Anggaran tidak boleh negatif.") 
        self.__anggaran = nilai 

    def kurangi_anggaran(self, jumlah): 
        if jumlah < 0: 
            raise ValueError("Jumlah harus positif.") 
        if jumlah > self.__anggaran: 
            raise ValueError("Anggaran tidak mencukupi.") 
        self.__anggaran -= jumlah 
        return self.__anggaran

# a. Buat class Mahasiswa
class Mahasiswa:
    def __init__(self, nim, nama, semester=1, ipk=0.0):
        # Public
        self.nim = nim
        self.nama = nama
        # Protected
        self._semester = semester
        # Private
        self.__ipk = ipk

    # --- Getter dan Setter untuk Protected (_semester) ---
    def get_semester(self):
        return self._semester

    def set_semester(self, nilai_baru):
        if nilai_baru < 1:
            raise ValueError("Semester minimal adalah 1.")
        self._semester = nilai_baru

    # --- Getter dan Setter untuk Private (__ipk) ---
    def get_ipk(self):
        return self.__ipk

    def set_ipk(self, nilai_baru):
        if not (0.0 <= nilai_baru <= 4.0):
            raise ValueError("IPK harus antara 0.0 dan 4.0")
        self.__ipk = round(nilai_baru, 2)


