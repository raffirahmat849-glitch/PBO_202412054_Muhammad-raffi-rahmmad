class MataKuliah:
    # PERBAIKAN: Mengganti _init_ dengan __init__
    def __init__(self, kode, nama):
        self.kode = kode
        self.nama = nama
        self.mahasiswa = []

    def tambah_mahasiswa(self, mhs):
        # Memastikan objek yang ditambahkan adalah Mahasiswa
        if isinstance(mhs, Mahasiswa):
            # Cek apakah mahasiswa sudah terdaftar (pencegahan duplikasi, opsional)
            if mhs not in self.mahasiswa:
                self.mahasiswa.append(mhs)
            # else:
            #     print(f"{mhs.nama} sudah terdaftar di {self.nama}.")
        else:
            print(f"Error: {mhs} bukan objek Mahasiswa.")

    def daftar_mahasiswa(self):
        # Mengembalikan list yang hanya berisi nama-nama mahasiswa
        return [m.nama for m in self.mahasiswa]

    # a. Tambahkan method jumlah_mahasiswa()
    def jumlah_mahasiswa(self):
        """Mengembalikan jumlah total mahasiswa yang terdaftar."""
        return len(self.mahasiswa)

class Mahasiswa:
    # PERBAIKAN: Mengganti _init_ dengan __init__
    def __init__(self, nim, nama):
        self.nim = nim
        self.nama = nama

# --- Contoh penggunaan ---

# b. Buat 2 mata kuliah dan 3 mahasiswa
# Mata Kuliah 1
mk1 = MataKuliah("TI101", "Pemrograman Dasar")
# Mata Kuliah 2
mk2 = MataKuliah("MM203", "Kalkulus Lanjut")

# 3 Mahasiswa
m1 = Mahasiswa("23001", "Budi")
m2 = Mahasiswa("23002", "Siti")
m3 = Mahasiswa("23003", "Andi")

# Daftarkan mahasiswa ke masing-masing mata kuliah
# Mahasiswa untuk MK1
mk1.tambah_mahasiswa(m1)
mk1.tambah_mahasiswa(m2)

# Mahasiswa untuk MK2
mk2.tambah_mahasiswa(m2) # Siti juga mengambil Kalkulus Lanjut
mk2.tambah_mahasiswa(m3)

# c. Tampilkan daftar mahasiswa dan jumlah mahasiswanya
print("="*50)
print(f"ANALISIS DAFTAR MAHASISWA")
print("="*50)

# --- Tampilan untuk Mata Kuliah 1 ---
print(f"Mata Kuliah: {mk1.nama} ({mk1.kode})")
print(f"  Daftar Mahasiswa: {mk1.daftar_mahasiswa()}")
print(f"  Jumlah Mahasiswa: {mk1.jumlah_mahasiswa()}")

print("-" * 50)

# --- Tampilan untuk Mata Kuliah 2 ---
print(f"Mata Kuliah: {mk2.nama} ({mk2.kode})")
print(f"  Daftar Mahasiswa: {mk2.daftar_mahasiswa()}")
print(f"  Jumlah Mahasiswa: {mk2.jumlah_mahasiswa()}")
print("="*50)