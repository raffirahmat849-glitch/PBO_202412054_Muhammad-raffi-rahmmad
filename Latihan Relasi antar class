# relasi aggregation 
class Nilai: 
    def __init__(self, kode_mk: str, skor: float): 
        self.kode_mk = kode_mk 
        self.skor = skor 
    
    def __str__(self):
        """Representasi string untuk menampilkan objek Nilai."""
        return f"({self.kode_mk}: {self.skor})"
  
class Mahasiswa: 
    def __init__(self, nim, nama): 
        self.nim = nim 
        self.nama = nama 
        self.daftar_nilai = []   # agregasi: Nilai dapat berdiri sendiri 
  
    def tambah_nilai(self, nilai: Nilai): 
        self.daftar_nilai.append(nilai) 
    
    # f. Tambahkan method rata_rata()
    def rata_rata(self) -> float:
        """Menghitung rata-rata skor dari semua nilai yang dimiliki mahasiswa."""
        if not self.daftar_nilai:
            return 0.0
        total_skor = sum(n.skor for n in self.daftar_nilai)
        return total_skor / len(self.daftar_nilai)
  
    def __str__(self):
        """Representasi string untuk menampilkan objek Mahasiswa."""
        return f"{self.nim} - {self.nama}"

class MataKuliah: 
    def __init__(self, kode: str, nama:str): 
        self.kode = kode 
        self.nama = nama 
    
    def __str__(self):
        return f"{self.kode} ({self.nama})"
  
class ProgramStudi: 
    def __init__(self, nama): 
        self.nama = nama 
        self.daftar_matakuliah = []   # agregasi 
  
    def tambah_matakuliah(self, mk: MataKuliah): 
        self.daftar_matakuliah.append(mk) 
  
# relasi composition 
class Universitas: 
    def __init__(self, nama): 
        self.nama = nama 
        self.programs: list[ProgramStudi] = []   
  
    def buat_program(self, nama_prodi) -> ProgramStudi: 
        # ProgramStudi tidak bisa eksis tanpa Universitas (Composition)
        prodi = ProgramStudi(nama_prodi) 
        self.programs.append(prodi) 
        return prodi 
    
# Fungsi pelaporan (report_program)
def report_program(prodi: ProgramStudi, semua_mahasiswa: list[Mahasiswa]): 
    print(f"\n[ REPORT | PROGRAM STUDI: {prodi.nama} ]") 
    print("Matakuliah:", ", ".join([f"{mk.kode}" for mk in prodi.daftar_matakuliah]) or "-") 
    print("Mahasiswa dan rata-rata nilai di Prodi ini:") 
    
    mahasiswa_prodi_terdaftar = False
    
    for m in semua_mahasiswa: 
        # Cek nilai mahasiswa yang kode_mk-nya terdaftar di Mata Kuliah Prodi ini
        relevan = [
            n for n in m.daftar_nilai 
            if any(n.kode_mk == mk.kode for mk in prodi.daftar_matakuliah)
        ] 
        if relevan: 
            mahasiswa_prodi_terdaftar = True
            # Hitung rata-rata nilai hanya dari mata kuliah yang relevan dengan Prodi ini
            avg = sum(n.skor for n in relevan) / len(relevan) 
            print(f"  {m.nim} - {m.nama} (Rata-rata MK Relevan): {round(avg,2)}") 
            
    if not mahasiswa_prodi_terdaftar:
        print("  Tidak ada mahasiswa terdaftar di Mata Kuliah Prodi ini.")
        
    print("-" * 50) 


